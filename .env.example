# Copy to .env and fill in. NEVER commit .env
# No spaces around "=" and no comments on the same line as a value.

# ---- Choose providers (google | openai | anthropic) ----
EMBEDDING_PROVIDER=google
LLM_PROVIDER=google

# Optional: backup LLM providers tried in order if the main one fails
# (only used if that provider's key is set). Example: anthropic,openai
LLM_FALLBACKS=

# Optional: override the model. Leave empty to use each provider's default.
EMBEDDING_MODEL=
LLM_MODEL=

# ---- API keys (only the providers you use) ----
# You can put several keys for one provider separated by commas: key1,key2
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
